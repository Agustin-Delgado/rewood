{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test"],
  // The catalogue lives in the app (bundler resolution, JSON imports); its
  // test runs under vitest, which resolves it the app's way.
  "exclude": ["test/catalog.test.ts"]
}
