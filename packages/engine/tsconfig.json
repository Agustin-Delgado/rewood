{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test"],
  // The catalogue and the workshop library live in the app (bundler
  // resolution, JSON imports); their tests run under vitest, which resolves
  // them the app's way.
  "exclude": ["test/catalog.test.ts", "test/workshop.test.ts"]
}
