{
  "schemaVersion": "1.0",
  "id": "bookcase_adjustable",
  "name": "Biblioteca 900×2000×320: estante fijo al medio y regulables con soportes",
  "parameters": {
    "width": 900,
    "height": 2000,
    "depth": 320,
    "fixed_z": 1000,
    "low_count": 2,
    "high_count": 3
  },
  "options": [
    { "param": "width", "label": "Ancho", "group": "Medidas", "min": 400, "max": 900, "step": 10, "unit": "mm" },
    { "param": "height", "label": "Alto", "group": "Medidas", "min": 1600, "max": 2400, "step": 10, "unit": "mm" },
    { "param": "depth", "label": "Profundidad", "group": "Medidas", "min": 200, "max": 450, "step": 10, "unit": "mm" },
    { "param": "fixed_z", "label": "Altura del estante fijo", "group": "Interior", "min": 600, "max": "height - 600", "step": 10, "unit": "mm" },
    { "param": "low_count", "label": "Estantes abajo", "group": "Interior", "min": 0, "max": 5, "step": 1 },
    { "param": "high_count", "label": "Estantes arriba", "group": "Interior", "min": 0, "max": 6, "step": 1 }
  ],
  "material": "melamine_18",
  "edgeMaterial": "pvc_0_45mm",
  "components": [
    {
      "type": "carcass",
      "id": "carcass",
      "joint": {
        "hardware": [
          "minifix_15",
          "dowel_8x30"
        ]
      },
      "back": {
        "material": "hdf_3"
      },
      "legs": {
        "plinth": {
          "setback": 30
        }
      }
    },
    {
      "type": "shelves",
      "id": "fixed",
      "positions": [
        "fixed_z"
      ],
      "joint": {
        "hardware": [
          "minifix_15",
          "dowel_8x30"
        ]
      }
    },
    {
      "type": "shelves",
      "id": "low",
      "zone": {
        "from": 0,
        "to": "fixed_z"
      },
      "count": "low_count",
      "support": "pins",
      "pins": {
        "adjust": 96
      }
    },
    {
      "type": "shelves",
      "id": "high",
      "zone": {
        "from": "fixed_z + carcass.thickness",
        "to": "height"
      },
      "count": "high_count",
      "support": "pins",
      "pins": {
        "adjust": 96
      }
    }
  ],
  "constraints": [
    {
      "id": "span",
      "expr": "carcass.inner_width <= 900",
      "message": "Un estante de más de 900 mm de luz en melamina de 18 se pandea"
    }
  ]
}
