{
  "schemaVersion": "1.0",
  "id": "sideboard",
  "name": "Aparador 1600 con push-open, cajones con cierre suave y patas 120",
  "parameters": {
    "width": 1600,
    "height": 770,
    "depth": 450,
    "side_bay": 500,
    "drawers": 3
  },
  "options": [
    { "param": "width", "label": "Ancho", "group": "Medidas", "min": "2 * side_bay + 472", "max": 2400, "step": 10, "unit": "mm" },
    { "param": "height", "label": "Alto", "group": "Medidas", "min": 600, "max": 900, "step": 10, "unit": "mm" },
    { "param": "depth", "label": "Profundidad", "group": "Medidas", "min": 430, "max": 550, "step": 10, "unit": "mm" },
    { "param": "side_bay", "label": "Ancho de los módulos laterales", "group": "Interior", "min": 300, "max": "min(700, floor((width - 472) / 20) * 10)", "step": 10, "unit": "mm" },
    { "param": "drawers", "label": "Cajones", "group": "Interior", "min": 1, "max": 5, "step": 1 }
  ],
  "material": "melamine_18",
  "edgeMaterial": "pvc_0_45mm",
  "components": [
    {
      "type": "carcass",
      "id": "carcass",
      "bays": 3,
      "bayWidths": ["side_bay", "auto", "side_bay"],
      "joint": { "hardware": ["minifix_15", "dowel_8x30"] },
      "back": { "material": "hdf_3" },
      "legs": { "hardware": ["leg_adjustable_120"], "plinth": { "setback": 40 } }
    },
    { "type": "shelves", "id": "shelf_left", "bay": 1, "count": 1, "support": "pins" },
    { "type": "shelves", "id": "shelf_right", "bay": 3, "count": 1, "support": "pins" },
    {
      "type": "drawers",
      "id": "drawers",
      "bay": 2,
      "count": "drawers",
      "softClose": true,
      "joint": { "hardware": ["dowel_8x30"], "placement": { "endOffset": 40, "maxSpacing": 150 } },
      "slide": { "hardware": ["slide_ball_400"] },
      "handle": { "hardware": ["handle_bar_160"] }
    },
    {
      "type": "doors",
      "id": "door_left",
      "bay": 1,
      "count": 1,
      "catch": { "hardware": ["push_latch"] }
    },
    {
      "type": "doors",
      "id": "door_right",
      "bay": 3,
      "count": 1,
      "softClose": true,
      "handle": { "hardware": ["handle_bar_160"] }
    }
  ]
}
