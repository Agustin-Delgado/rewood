      "back": { "material": "hdf_3" },
      "legs": { "plinth": { "setback": 40 } }
    },
    {
      "type": "drawers",
      "id": "drawers",
      "count": "drawers",
      "joint": { "hardware": ["minifix_15", "dowel_8x30"] },
      "slide": { "hardware": ["slide_ball_500"] },
      "softClose": true,
