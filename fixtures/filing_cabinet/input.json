    { "param": "height", "label": "Alto", "group": "Medidas", "min": "ceil((36 + 290 * drawers) / 10) * 10", "max": 1350, "step": 10, "unit": "mm" },
    { "param": "depth", "label": "Profundidad", "group": "Medidas", "min": 560, "max": 700, "step": 10, "unit": "mm" },
    { "param": "drawers", "label": "Cajones", "group": "Cajones", "min": 1, "max": "min(4, floor((height - 36) / 290))", "step": 1 }
