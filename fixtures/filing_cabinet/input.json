{
  "schemaVersion": "1.0",
  "id": "filing_cabinet",
  "name": "Archivero de carpetas colgantes oficio, 2 cajones",
  "version": "1.0",
  "parameters": {
    "width": 475,
    "height": 720,
    "depth": 600,
    "drawers": 2
