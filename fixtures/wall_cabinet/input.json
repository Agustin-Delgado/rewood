{
  "schemaVersion": "1.0",
  "id": "wall_cabinet",
  "name": "Alacena colgante 900×720×350: dos puertas y estante regulable",
  "parameters": {
    "width": 900,
    "height": 720,
    "depth": 350,
    "shelf_count": 1,
    "door_count": 2,
    "lift": false
  },
  "options": [
    { "param": "width", "label": "Ancho", "group": "Medidas", "min": 300, "max": 1200, "step": 10, "unit": "mm" },
    { "param": "height", "label": "Alto", "group": "Medidas", "min": 300, "max": 1000, "step": 10, "unit": "mm" },
    { "param": "depth", "label": "Profundidad", "group": "Medidas", "min": 250, "max": 400, "step": 10, "unit": "mm" },
    { "param": "shelf_count", "label": "Estantes", "group": "Interior", "min": 0, "max": 4, "step": 1 },
    { "param": "lift", "label": "Puerta basculante", "group": "Interior", "help": "Una sola puerta que se abre hacia arriba, sostenida por dos pistones." },
    { "param": "door_count", "label": "Puertas", "group": "Interior", "choices": [{ "value": 1, "label": "una" }, { "value": 2, "label": "dos" }], "when": "not lift" }
  ],
  "material": "melamine_18",
  "edgeMaterial": "abs_1mm",
  "components": [
    {
      "type": "carcass",
      "id": "carcass",
      "joint": {
        "hardware": [
          "minifix_15",
          "dowel_8x30"
        ]
      },
      "back": {
        "material": "hdf_3"
      },
      "hanging": {}
    },
    {
      "type": "shelves",
      "id": "shelves",
      "count": "shelf_count",
      "support": "pins"
    },
    {
      "type": "doors",
      "id": "flap",
      "when": "lift",
      "count": 1,
      "opening": "up",
      "handle": {
        "hardware": [
          "handle_bar_128"
        ]
      }
    },
    {
      "type": "doors",
      "id": "doors",
      "when": "not lift",
      "count": "door_count",
      "handle": {
        "hardware": [
          "handle_bar_128"
        ]
      }
    }
  ],
  "constraints": [
    {
      "id": "hang_depth",
      "expr": "depth <= 400",
      "severity": "WARNING",
      "message": "Una alacena de más de 400 mm de profundidad tapa la mesada"
    }
  ]
}
