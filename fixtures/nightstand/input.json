{
  "schemaVersion": "1.0",
  "id": "nightstand",
  "name": "Mesa de luz 450×550×400: cajón y puerta",
  "parameters": {
    "width": 450,
    "height": 550,
    "depth": 400,
    "drawer_zone": 180
  },
  "material": "melamine_18",
  "edgeMaterial": "abs_1mm",
  "components": [
    {
      "type": "carcass",
      "id": "carcass",
      "joint": {
        "hardware": [
          "minifix_15",
          "dowel_8x30"
        ]
      },
      "back": {
        "material": "hdf_3"
      },
      "legs": {
        "plinth": {
          "setback": 30
        }
      }
    },
    {
      "type": "drawers",
      "id": "drawer",
      "zone": {
        "from": "height - drawer_zone",
        "to": "height"
      },
      "count": 1,
      "joint": {
        "hardware": [
          "dowel_8x30"
        ],
        "placement": {
          "endOffset": 40,
          "maxSpacing": 150
        }
      },
      "slide": {
        "hardware": [
          "slide_ball_350"
        ]
      },
      "handle": {
        "hardware": [
          "handle_bar_128"
        ]
      }
    },
    {
      "type": "shelves",
      "id": "shelf",
      "zone": {
        "from": 0,
        "to": "height - drawer_zone"
      },
      "count": 1,
      "support": "pins"
    },
    {
      "type": "doors",
      "id": "door",
      "zone": {
        "from": 0,
        "to": "height - drawer_zone"
      },
      "count": 1,
      "handle": {
        "hardware": [
          "handle_bar_128"
        ]
      }
    }
  ],
  "constraints": [
    {
      "id": "drawer_zone",
      "expr": "drawer_zone >= 120 and drawer_zone <= 250",
      "severity": "WARNING",
      "message": "El cajón de una mesa de luz va entre 120 y 250 mm de alto"
    }
  ]
}
