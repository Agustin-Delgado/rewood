          "minifix_15",
          "dowel_8x30"
        ]
      },
      "back": {
        "material": "hdf_3"
      },
      "legs": {}
    },
    {
      "type": "drawers",
      "id": "drawers_left",
      "bay": 1,
      "count": 1,
