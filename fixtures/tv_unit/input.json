        "hardware": [
          "dowel_8x30"
        ],
        "placement": {
          "endOffset": 40,
          "maxSpacing": 150
        }
      },
      "slide": {
        "hardware": [
          "slide_ball_350"
        ]
      },
      "handle": {
        "hardware": [
          "handle_bar_128"
        ]
      }
    },
    {
      "type": "shelves",
      "id": "middle_shelf",
      "bay": 2,
      "count": 1,
      "support": "pins"
    },
    {
      "type": "drawers",
      "id": "drawers_right",
      "bay": 3,
      "count": 1,
      "joint": {
        "hardware": [
          "dowel_8x30"
        ],
        "placement": {
          "endOffset": 40,
          "maxSpacing": 150
        }
      },
      "slide": {
        "hardware": [
          "slide_ball_350"
        ]
      },
      "handle": {
        "hardware": [
          "handle_bar_128"
        ]
      }
    }
