{
  "schemaVersion": "1.0",
  "id": "tv_unit",
  "name": "Mueble de TV 1800×450×420: cajones a los lados, hueco al medio",
  "parameters": {
    "width": 1800,
    "height": 450,
    "depth": 420,
    "middle": 800,
    "t": 18,
    "sides": 0
  },
  "options": [
    { "param": "width", "label": "Ancho", "group": "Medidas", "min": "middle + 672", "max": 2400, "step": 10, "unit": "mm" },
    { "param": "height", "label": "Alto", "group": "Medidas", "min": 300, "max": 500, "step": 10, "unit": "mm" },
    { "param": "depth", "label": "Profundidad", "group": "Medidas", "min": 380, "max": 500, "step": 10, "unit": "mm" },
    { "param": "middle", "label": "Hueco del medio", "group": "Interior", "min": 400, "max": "min(900, width - 672)", "step": 10, "unit": "mm", "help": "Más de 900 mm, la tapa y el estante del medio se pandean." },
    { "param": "sides", "label": "A los lados", "group": "Interior", "choices": [{ "value": 0, "label": "cajones" }, { "value": 1, "label": "puertas" }, { "value": 2, "label": "abiertos" }, { "value": 3, "label": "rebatibles" }] }
  ],
  "material": "melamine_18",
  "edgeMaterial": "abs_1mm",
  "components": [
    {
      "type": "carcass",
      "id": "carcass",
      "bays": 3,
      "bayWidths": [
        "auto",
        "middle",
        "(width - 4 * t - middle) / 2"
      ],
      "joint": {
        "hardware": [
          "minifix_15",
          "dowel_8x30"
        ]
      },
      "back": {
        "material": "hdf_3"
      },
      "legs": {}
    },
    {
      "type": "drawers",
      "id": "drawers_left",
      "when": "sides == 0",
      "bay": 1,
      "count": 1,
      "joint": {
        "hardware": [
          "dowel_8x30"
        ],
        "placement": {
          "endOffset": 40,
          "maxSpacing": 150
        }
      },
      "slide": {
        "hardware": [
          "slide_ball_350"
        ]
      },
      "handle": {
        "hardware": [
          "handle_bar_128"
        ]
      }
    },
    {
      "type": "doors",
      "id": "door_left",
      "when": "sides == 1",
      "bay": 1,
      "count": 1,
      "catch": { "hardware": ["push_latch"] }
    },
    {
      "type": "doors",
      "id": "door_right",
      "when": "sides == 1",
      "bay": 3,
      "count": 1,
      "catch": { "hardware": ["push_latch"] }
    },
    {
      "type": "doors",
      "id": "flap_left",
      "when": "sides == 3",
      "bay": 1,
      "count": 1,
      "opening": "down",
      "handle": { "hardware": ["handle_bar_128"] }
    },
    {
      "type": "doors",
      "id": "flap_right",
      "when": "sides == 3",
      "bay": 3,
      "count": 1,
      "opening": "down",
      "handle": { "hardware": ["handle_bar_128"] }
    },
    {
      "type": "shelves",
      "id": "side_shelves",
      "when": "sides == 2",
      "bay": 1,
      "count": 1,
      "support": "pins"
    },
    {
      "type": "shelves",
      "id": "side_shelves_right",
      "when": "sides == 2",
      "bay": 3,
      "count": 1,
      "support": "pins"
    },
    {
      "type": "shelves",
      "id": "middle_shelf",
      "bay": 2,
      "count": 1,
      "support": "pins"
    },
    {
      "type": "drawers",
      "id": "drawers_right",
      "when": "sides == 0",
      "bay": 3,
      "count": 1,
      "joint": {
        "hardware": [
          "dowel_8x30"
        ],
        "placement": {
          "endOffset": 40,
          "maxSpacing": 150
        }
      },
      "slide": {
        "hardware": [
          "slide_ball_350"
        ]
      },
      "handle": {
        "hardware": [
          "handle_bar_128"
        ]
      }
    }
  ],
  "constraints": [
    {
      "id": "tv_height",
      "expr": "height <= 500",
      "severity": "WARNING",
      "message": "Más de 500 mm deja la pantalla alta para mirar sentado"
    }
  ]
}
