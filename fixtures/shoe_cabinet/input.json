{
  "schemaVersion": "1.0",
  "id": "shoe_cabinet",
  "name": "Zapatero 800×1000×350 con puertas",
  "version": "1.0",
  "parameters": {
    "width": 800,
    "height": 1000,
    "depth": 350,
    "bays": 1,
    "shelves": 4,
    "doors": true
  },
  "options": [
    { "param": "doors", "label": "Con puertas", "group": "Frente", "help": "Sin puertas es un banco zapatero abierto." },
    { "param": "width", "label": "Ancho", "group": "Medidas", "min": "max(450, bays * 318 + 18)", "max": "min(1800, bays * 900 + 18)", "step": 10, "unit": "mm" },
    { "param": "height", "label": "Alto", "group": "Medidas", "min": "max(400, ceil((36 + 150 * (shelves + 1)) / 10) * 10)", "max": 1400, "step": 10, "unit": "mm", "help": "Para sentarse, unos 450." },
    { "param": "depth", "label": "Profundidad", "group": "Medidas", "min": 300, "max": 420, "step": 10, "unit": "mm" },
    { "param": "bays", "label": "Huecos", "group": "Interior", "min": 1, "max": "min(4, floor((width - 18) / 318))", "step": 1 },
    { "param": "shelves", "label": "Estantes por hueco", "group": "Interior", "min": 0, "max": "min(6, floor((height - 36) / 150) - 1)", "step": 1, "help": "Cada par de zapatos pide unos 150 mm de alto." }
  ],
  "material": "melamine_18",
  "edgeMaterial": "abs_1mm",
  "components": [
    {
      "type": "carcass",
      "id": "carcass",
      "bays": "bays",
      "joint": { "hardware": ["minifix_15", "dowel_8x30"] },
      "back": { "material": "hdf_3" },
      "legs": { "plinth": { "setback": 40 } }
    },
    {
      "type": "shelves",
      "id": "shelves",
      "when": "shelves > 0",
      "count": "shelves",
      "support": "pins",
      "pins": { "adjust": 64 }
    },
    {
      "type": "doors",
      "id": "doors",
      "when": "doors",
      "count": "if(width / bays > 600, 2, 1)",
      "catch": { "hardware": ["push_latch"] }
    }
  ]
}
