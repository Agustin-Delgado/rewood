{
  "schemaVersion": "1.0",
  "id": "wardrobe_sliding",
  "name": "Placard 1800×2100 con puertas corredizas",
  "version": "1.0",
  "parameters": {
    "width": 1800,
    "height": 2100,
    "depth": 600,
    "doors": 2,
    "drawers": 3,
    "shelves": 4,
    "drawer_zone_top": 700,
    "track": 60,
    "behind": "track + 5"
  },
  "options": [
    { "param": "width", "label": "Ancho", "group": "Medidas", "min": 1200, "max": 1830, "step": 10, "unit": "mm", "help": "Más ancho, el fondo de HDF no sale de una placa." },
    { "param": "height", "label": "Alto", "group": "Medidas", "min": "max(1800, drawer_zone_top + 1100)", "max": 2600, "step": 10, "unit": "mm" },
    { "param": "depth", "label": "Profundidad", "group": "Medidas", "min": 560, "max": 700, "step": 10, "unit": "mm", "help": "El riel se lleva 60 mm del frente." },
    { "param": "doors", "label": "Puertas", "group": "Puertas", "choices": [{ "value": 2, "label": "dos" }, { "value": 3, "label": "tres" }] },
    { "param": "shelves", "label": "Estantes", "group": "Interior", "min": 0, "max": 6, "step": 1 },
    { "param": "drawers", "label": "Cajones interiores", "group": "Interior", "min": 1, "max": "min(4, floor((drawer_zone_top - 18) / 130))", "step": 1 },
    { "param": "drawer_zone_top", "label": "Alto de la cajonera", "group": "Interior", "min": "max(300, ceil((18 + 130 * drawers) / 10) * 10)", "max": 900, "step": 10, "unit": "mm" }
  ],
  "material": "melamine_18",
  "edgeMaterial": "abs_1mm",
  "components": [
    {
      "type": "carcass",
      "id": "carcass",
      "bays": 2,
      "dividerSetback": "track",
      "joint": { "hardware": ["minifix_15", "dowel_8x30"] },
      "back": { "material": "hdf_3" },
      "legs": { "plinth": { "setback": 40 } }
    },
    { "type": "rail", "id": "rail", "bay": 1 },
    {
      "type": "drawers",
      "id": "drawers",
      "bay": 2,
      "zone": { "from": 0, "to": "drawer_zone_top" },
      "count": "drawers",
      "mount": "inset",
      "setback": "behind",
      "joint": { "hardware": ["dowel_8x30"], "placement": { "endOffset": 40, "maxSpacing": 150 } },
      "slide": { "hardware": ["slide_ball_450"] }
    },
    {
      "type": "shelves",
      "id": "shelves",
      "bay": 2,
      "zone": { "from": "drawer_zone_top", "to": "height" },
      "count": "shelves",
      "setback": "behind",
      "when": "shelves > 0",
      "joint": { "hardware": ["dowel_8x30"] }
    },
    { "type": "sliding_doors", "id": "doors", "count": "doors" }
  ]
}
