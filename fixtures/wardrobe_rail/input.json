{
  "schemaVersion": "1.0",
  "id": "wardrobe_rail",
  "name": "Placard 1200×2100 con barral, cajones interiores y puerta embutida",
  "parameters": {
    "width": 1200,
    "height": 2100,
    "depth": 560,
    "drawer_zone_top": 500,
    "door_gap": 2,
    "drawers": 2,
    "shelves": 4
  },
  "options": [
    { "param": "width", "label": "Ancho", "group": "Medidas", "min": 900, "max": 1800, "step": 10, "unit": "mm" },
    { "param": "height", "label": "Alto", "group": "Medidas", "min": "drawer_zone_top + 1580", "max": 2600, "step": 10, "unit": "mm" },
    { "param": "depth", "label": "Profundidad", "group": "Medidas", "min": 540, "max": 650, "step": 10, "unit": "mm" },
    { "param": "drawers", "label": "Cajones bajo el barral", "group": "Interior", "min": 1, "max": 3, "step": 1 },
    { "param": "drawer_zone_top", "label": "Alto de los cajones", "group": "Interior", "min": 300, "max": "min(500, height - 1580)", "step": 10, "unit": "mm" },
    { "param": "shelves", "label": "Estantes", "group": "Interior", "min": 0, "max": 6, "step": 1 }
  ],
  "material": "melamine_18",
  "edgeMaterial": "pvc_0_45mm",
  "components": [
    {
      "type": "carcass",
      "id": "carcass",
      "bays": 2,
      "joint": { "hardware": ["minifix_15", "dowel_8x30"] },
      "back": { "material": "hdf_3" },
      "legs": { "plinth": { "setback": 40 } }
    },
    { "type": "rail", "id": "rail", "bay": 1 },
    {
      "type": "drawers",
      "id": "drawers",
      "bay": 1,
      "zone": { "from": 0, "to": "drawer_zone_top" },
      "count": "drawers",
      "mount": "inset",
      "setback": "carcass.thickness + door_gap",
      "joint": { "hardware": ["dowel_8x30"], "placement": { "endOffset": 40, "maxSpacing": 150 } },
      "slide": { "hardware": ["slide_ball_450"] }
    },
    {
      "type": "shelves",
      "id": "shelves",
      "bay": 2,
      "count": "shelves",
      "joint": { "hardware": ["dowel_8x30"] }
    },
    {
      "type": "doors",
      "id": "door_left",
      "bay": 1,
      "count": 1,
      "gap": "door_gap",
      "mount": "inset",
      "handle": { "hardware": ["handle_bar_128"] }
    },
    {
      "type": "doors",
      "id": "door_right",
      "bay": 2,
      "count": 1,
      "gap": "door_gap",
      "handle": { "hardware": ["handle_bar_128"] }
    }
  ],
  "constraints": [
    { "id": "hang", "expr": "rail.hang >= 1500", "severity": "WARNING", "message": "Bajo el barral tiene que entrar un tapado (1500 mm)" }
  ]
}
